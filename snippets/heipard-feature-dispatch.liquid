{%- comment -%}
  Feature-Baukasten: rendert EINEN Metaobjekt-Block (feature_block) nach Typ.
  Der Typ steht im Feld "Block-Typ" (layout). Spezifikation: docs/heipard-block-vokabular.md

  Typen:
    fullwidth     B1 Full-Width-Bild (mit Video: B3, laut)
    media_text    B2 Split (mit Video: B3, laut; Variante sticky)
    text          R1 Text schmal
    kettenplan    D1 (Varianten linie, flaeche, koppel)
    zeitband      D3 (Varianten timer, solar)
    serienleiter  D4 (Daten-Zone)
    steuerung     I2 Dimmregler + I3 Modus-Umschalter (mit Modi laut)
    icon_grid     B4 aus Metafeldern
    hotspot       P1 Hotspot-Detail
    lieferumfang  P3 (Daten-Zone)
    schieber      I1 Schieber Aus und An (laut)
    kelvin        D2 Kelvin-Skala
    nachweise     D5 (Daten-Zone)
    kennzahl      D6 Große Kennzahl
    fragen        D7 (Daten-Zone)
    sequenz       P2 Sequenz
    farbwechsel   I4 Farbwechsel (laut; Varianten ueberblendung, rgb)
    zaesur        R2 Zäsur (zählt nicht zum Block-Limit)
    szene         Szenenbild R2/R3 (Variante r2, r3): Bild aus heipard.feature_r2/_r3,
                  ohne Bild kein Markup; zählt nicht zum Block-Limit.
                  Ohne Variante r2/r3: Zusatzzeile (Auftrag Teil C, 19.11.2026), Bild am Block,
                  eigene Überschrift und Text; zählt ebenfalls nicht zum Block-Limit

  Ausgabe-Protokoll für die Sektion:
    <!--fb-loud-->   der Block ist laut (zählt gegen das Limit)
    <!--fb-note-->   danach folgt ein Hinweistext für den Theme-Editor
  Ein Block ohne Inhalt oder ohne Daten gibt kein Markup aus. Hat der Block im
  JSON-Feld { "sonst": "<typ>" }, wird dann dieser Typ versucht (z. B. Kettenplan,
  sonst Zeitband).

  R1 mit Bild und Szene geben vor dem Markup <!--fb-split--> aus: die Sektion behandelt den
  Block dann wie eine Bild-Text-Zeile (kein schmales Paar, zählt für den Seitenwechsel).

  Parameter: blk, product, index, allow_loud, uid, split_side ('left' | 'right', für R1 mit Bild und Szene),
             slot ('b1' | 'b2' | leer): B1/B2 ohne Bild am Block nehmen das Bild aus feature_b1/_b2
{%- endcomment -%}
{%- liquid
  assign type = blk.layout.value | default: 'media_text'
  assign blk_label = blk.label.value | default: type
  assign data = blk.data.value
  assign types = type
  if data.sonst != blank
    assign types = type | append: ',' | append: data.sonst
  endif
  assign types = types | split: ','
  assign notes = ''
-%}
{%- for cur in types -%}
  {%- capture out -%}
    {%- case cur -%}
      {%- when 'fullwidth', 'media_text' -%}
        {%- liquid
          assign img = blk.image.value
          assign vid = blk.video.value
          # B1/B2 ohne Bild und Video am Block: Bild aus dem Produkt-Metafeld feature_b1 bzw.
          # feature_b2 (slot kommt aus der Sektion). Auftrag Teil B, 19.11.2026.
          if img == blank and vid == blank
            if slot == 'b1' and cur == 'fullwidth'
              assign img = product.metafields.heipard.feature_b1.value
            elsif slot == 'b2' and cur == 'media_text'
              assign img = product.metafields.heipard.feature_b2.value
            endif
          endif
          assign has_content = false
          if img != blank or vid != blank
            assign has_content = true
          endif
          if blk.kicker.value != blank or blk.title.value != blank or blk.body.value != blank
            assign has_content = true
          endif
          assign m_type = blk.media_type.value | default: 'image'
          # Clips (Auftrag Teil H, 22.11.2026): video_einmal und video_schleife enden auf dem Bild am
          # Block. Sie gelten deshalb nur, wenn das gezeigte Bild ihr Standbild ist (Bild am Block oder
          # Paar in clip_produktbild, siehe unten), und nur nach dem Theme-Schalter clip_mode (aus, nur
          # Testseiten, alle Seiten).
          # Teil I (22.11.2026): Ausschlussliste clip_ausschluss (z. B. nur Kaltweiß/Bunt bei warmweißem
          # Clip), Mobil-Fassungen video_einmal_mobil / video_schleife_mobil; ohne Mobil-Fassung kein Clip
          # auf schmalen Bildschirmen, außer für die Handles in clip_mobil_ersatz (große Fassung).
          # Bild aus feature_b1/_b2 (Block ohne eigenes Bild): Clip nur, wenn das Produktbild das Standbild
          # des Clips ist. Die Paare Block:Standbild stehen in clip_produktbild (z. B. ctl-b1:CTL_B1_01);
          # zeigt ein Produkt ein anderes Bild, bleibt es beim Bild.
          assign clip_once = nil
          assign clip_loop = nil
          assign clip_once_m = nil
          assign clip_loop_m = nil
          assign clip_ersatz = false
          assign clip_bild_ok = false
          if m_type != 'video' and img != blank
            if blk.image.value != blank
              assign clip_bild_ok = true
            else
              assign clip_stem = img | image_url: width: 10 | split: '?' | first | split: '/' | last | split: '.' | first
              assign clip_pb_key = blk.system.handle | append: ':' | append: clip_stem
              assign clip_pb = settings.clip_produktbild | remove: ' ' | split: ','
              if clip_pb contains clip_pb_key
                assign clip_bild_ok = true
              endif
            endif
          endif
          if clip_bild_ok
            assign clip_ok = false
            if settings.clip_mode == 'on'
              assign clip_ok = true
            elsif settings.clip_mode == 'test'
              assign clip_pages = settings.clip_test_handles | remove: ' ' | split: ','
              if clip_pages contains product.handle
                assign clip_ok = true
              endif
            endif
            assign clip_aus = settings.clip_ausschluss | remove: ' ' | split: ','
            if clip_aus contains product.handle
              assign clip_ok = false
            endif
            if clip_ok
              assign clip_once = blk.video_einmal.value
              assign clip_loop = blk.video_schleife.value
              assign clip_once_m = blk.video_einmal_mobil.value
              assign clip_loop_m = blk.video_schleife_mobil.value
              assign clip_ersatz_pages = settings.clip_mobil_ersatz | remove: ' ' | split: ','
              if clip_ersatz_pages contains product.handle
                assign clip_ersatz = true
              endif
            endif
          endif
          if has_content
            if m_type == 'video' and vid != blank
              if allow_loud
                echo '<!--fb-loud-->'
              else
                assign m_type = 'image'
                if request.design_mode
                  echo '<!--fb-note-->'
                  echo 'heipard.blocks.editor.loud' | t: block: blk_label
                  echo '<!--fb-note-->'
                endif
              endif
            endif
            render 'heipard-feature-block', layout: cur, media_type: m_type, image: img, video: vid, kicker: blk.kicker.value, title: blk.title.value, body: blk.body.value, index: index, media_side: blk.media_side.value, overlay_theme: blk.overlay_theme.value, variant: blk.variant.value, alt: blk.alt.value, clip_once: clip_once, clip_loop: clip_loop, clip_once_m: clip_once_m, clip_loop_m: clip_loop_m, clip_ersatz: clip_ersatz
          endif
        -%}
      {%- when 'text' -%}
        {%- liquid
          # R1 mit Bild (Block-Bild, sonst Produkt-Metafeld feature_r1): Bild-Text-Zeile wie B2,
          # Seite kommt aus der Sektion (split_side). Ohne Bild schmaler Text wie bisher.
          assign r1_img = blk.image.value
          if r1_img == blank
            assign r1_img = product.metafields.heipard.feature_r1.value
          endif
          if r1_img != blank
            echo '<!--fb-split-->'
            render 'heipard-feature-block', layout: 'media_text', media_type: 'image', image: r1_img, kicker: blk.kicker.value, title: blk.title.value, body: blk.body.value, index: index, media_side: split_side, variant: 'r1', alt: blk.alt.value
          else
            render 'heipard-fb-text', kicker: blk.kicker.value, title: blk.title.value, body: blk.body.value
          endif
        -%}
      {%- when 'szene' -%}
        {%- liquid
          # R2/R3 Szenenbild (Asset-Codes <FAM>_R2/_R3, nicht die Zäsur R2 aus dem Vokabular):
          # Bild nur aus dem Produkt-Metafeld heipard.feature_r2 (Variante r2) bzw. feature_r3
          # (Variante r3). Leeres Metafeld: kein Markup, der Block fällt still weg.
          # Mit Bild: Bild-Text-Zeile wie R1, Seite aus der Sektion (split_side), Bild 16:9.
          # Ohne Variante r2/r3 ist der Block eine Zusatzzeile (Auftrag Teil C, 19.11.2026): Bild
          # am Block, Bild-Text-Zeile wie B2 (Klasse heipard-feature__row--zusatz). Ohne Bild kein Markup.
          assign sz_img = ''
          assign sz_variant = 'szene'
          case blk.variant.value
            when 'r2'
              assign sz_img = product.metafields.heipard.feature_r2.value
            when 'r3'
              assign sz_img = product.metafields.heipard.feature_r3.value
            else
              assign sz_img = blk.image.value
              assign sz_variant = 'zusatz'
          endcase
          if sz_img != blank
            echo '<!--fb-split-->'
            render 'heipard-feature-block', layout: 'media_text', media_type: 'image', image: sz_img, kicker: blk.kicker.value, title: blk.title.value, body: blk.body.value, index: index, media_side: split_side, variant: sz_variant, alt: blk.alt.value
          endif
        -%}
      {%- when 'kettenplan' -%}
        {%- render 'heipard-fb-kettenplan', product: product, variant: blk.variant.value, kicker: blk.kicker.value, title: blk.title.value, body: blk.body.value, label: blk_label -%}
      {%- when 'zeitband' -%}
        {%- render 'heipard-fb-zeitband', product: product, variant: blk.variant.value, kicker: blk.kicker.value, title: blk.title.value, body: blk.body.value, label: blk_label, uid: uid -%}
      {%- when 'serienleiter' -%}
        {%- render 'heipard-fb-serienleiter', product: product, kicker: blk.kicker.value, title: blk.title.value, body: blk.body.value, label: blk_label -%}
      {%- when 'steuerung' -%}
        {%- render 'heipard-fb-steuerung', product: product, image: blk.image.value, data: data, kicker: blk.kicker.value, title: blk.title.value, body: blk.body.value, label: blk_label, uid: uid, allow_loud: allow_loud -%}
      {%- when 'icon_grid' -%}
        {%- render 'heipard-fb-icon-grid', product: product, data: data, label: blk_label -%}
      {%- when 'hotspot' -%}
        {%- render 'heipard-fb-hotspot', image: blk.image.value, data: data, kicker: blk.kicker.value, title: blk.title.value, body: blk.body.value, label: blk_label -%}
      {%- when 'lieferumfang' -%}
        {%- render 'heipard-fb-lieferumfang', product: product, image: blk.image.value, kicker: blk.kicker.value, title: blk.title.value, body: blk.body.value, label: blk_label -%}
      {%- when 'schieber' -%}
        {%- render 'heipard-fb-schieber', image: blk.image.value, image_2: blk.image_2.value, kicker: blk.kicker.value, title: blk.title.value, body: blk.body.value, label: blk_label, uid: uid, allow_loud: allow_loud -%}
      {%- when 'kelvin' -%}
        {%- render 'heipard-fb-kelvin', product: product, kicker: blk.kicker.value, title: blk.title.value, body: blk.body.value, label: blk_label -%}
      {%- when 'nachweise' -%}
        {%- render 'heipard-fb-nachweise', product: product, kicker: blk.kicker.value, title: blk.title.value, body: blk.body.value, label: blk_label -%}
      {%- when 'kennzahl' -%}
        {%- render 'heipard-fb-kennzahl', product: product, data: data, kicker: blk.kicker.value, title: blk.title.value, body: blk.body.value, label: blk_label -%}
      {%- when 'fragen' -%}
        {%- render 'heipard-fb-fragen', product: product, kicker: blk.kicker.value, title: blk.title.value, body: blk.body.value, label: blk_label -%}
      {%- when 'sequenz' -%}
        {%- render 'heipard-fb-sequenz', images: blk.images.value, kicker: blk.kicker.value, title: blk.title.value, body: blk.body.value, label: blk_label -%}
      {%- when 'farbwechsel' -%}
        {%- render 'heipard-fb-farbwechsel', image: blk.image.value, image_2: blk.image_2.value, variant: blk.variant.value, data: data, kicker: blk.kicker.value, title: blk.title.value, body: blk.body.value, label: blk_label, uid: uid, allow_loud: allow_loud -%}
      {%- when 'zaesur' -%}
        {%- render 'heipard-fb-zaesur', kicker: blk.kicker.value, title: blk.title.value, body: blk.body.value -%}
    {%- endcase -%}
  {%- endcapture -%}
  {%- liquid
    # Hinweise sind beidseitig mit <!--fb-note--> markiert, der Rest ist Markup.
    assign parts = out | split: '<!--fb-note-->'
    assign html = ''
    for part in parts
      assign piece = part | strip
      if piece == blank
        continue
      endif
      if piece contains '<'
        assign html = html | append: piece
      else
        assign notes = notes | append: '<!--fb-note-->' | append: piece
      endif
    endfor
    if html != blank
      echo html
      break
    endif
  -%}
{%- endfor -%}
{{- notes -}}
