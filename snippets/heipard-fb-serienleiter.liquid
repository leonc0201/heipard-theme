{%- comment -%}
  D4 Serienleiter: Längenvarianten derselben Familie als Nachbarmodelle.

  Quelle: Produkt-Metafeld heipard.familie (Code, z. B. "OL-G40"). Alle Produkte
  der Familie liegen in der Smart Collection "familie-<code>" (Regel: Metafeld
  Familie ist gleich Code). Die Kollektion liefert nur aktive Produkte.
  Sortierung nach heipard.beleuchtete_laenge_m, das aktuelle Modell ist markiert.

  Rendert nichts, wenn die Familie fehlt oder kein Nachbarmodell aktiv ist.
  Parameter: product, kicker, title, body, label
{%- endcomment -%}
{%- liquid
  assign familie = product.metafields.heipard.familie.value
  assign others = 0
  if familie != blank
    assign fam_handle = familie | handleize | prepend: 'familie-'
    assign fam = collections[fam_handle]
    assign max_len = 0
    for p in fam.products limit: 24
      if p.id != product.id
        assign others = others | plus: 1
      endif
      assign p_len = p.metafields.heipard.beleuchtete_laenge_m.value
      if p_len != blank and p_len > max_len
        assign max_len = p_len
      endif
    endfor
  endif
  assign default_kicker = 'heipard.blocks.serienleiter.kicker' | t
  assign default_title = 'heipard.blocks.serienleiter.title' | t
  assign head_kicker = kicker | default: default_kicker
  assign head_title = title | default: default_title
-%}
{%- if familie == blank -%}
  {%- if request.design_mode -%}
    <!--fb-note-->{{ 'heipard.blocks.editor.missing' | t: block: label, fields: 'heipard.familie' }}<!--fb-note-->
  {%- endif -%}
{%- elsif others > 0 -%}
  {%- capture entries -%}
    {%- for p in fam.products limit: 24 -%}
      {%- liquid
        assign p_len = p.metafields.heipard.beleuchtete_laenge_m.value
        assign p_points = p.metafields.heipard.led_anzahl.value
        assign sort_key = '99999999'
        assign share = 100
        if p_len != blank
          assign sort_key = p_len | times: 100 | round | prepend: '00000000' | slice: -8, 8
          if max_len > 0
            assign share = p_len | times: 100.0 | divided_by: max_len | round
          endif
        endif
        assign is_current = false
        if p.id == product.id
          assign is_current = true
        endif
      -%}
      {{- sort_key -}}@@key@@
      <li class="heipard-serie__item{% if is_current %} is-current{% endif %}">
        <a class="heipard-serie__link" href="{{ p.url }}"{% if is_current %} aria-current="page"{% endif %}>
          <span class="heipard-serie__bar" style="--share: {{ share }}%;" aria-hidden="true"></span>
          <span class="heipard-serie__length">
            {%- if p_len != blank -%}
              {%- capture p_len_txt -%}{%- render 'heipard-num', value: p_len -%}{%- endcapture -%}
              {{- 'heipard.blocks.serienleiter.length' | t: value: p_len_txt -}}
            {%- else -%}
              {{- p.title | escape -}}
            {%- endif -%}
          </span>
          {%- if p_points != blank and p_points > 0 -%}
            <span class="heipard-serie__meta">{{ 'heipard.blocks.kettenplan.points' | t: count: p_points }}</span>
          {%- endif -%}
          <span class="heipard-serie__meta heipard-serie__price">{{ p.price | money }}</span>
          {%- if is_current -%}
            <span class="heipard-serie__flag">{{ 'heipard.blocks.serienleiter.current' | t }}</span>
          {%- elsif p_len != blank -%}
            <span class="visually-hidden">{{ p.title | escape }}</span>
          {%- endif -%}
        </a>
      </li>
      {%- unless forloop.last -%}@@item@@{%- endunless -%}
    {%- endfor -%}
  {%- endcapture -%}
  <div class="heipard-fb heipard-fb--serienleiter">
    {%- render 'heipard-fb-head', kicker: head_kicker, title: head_title, body: body -%}
    <ol class="heipard-serie">
      {%- assign sorted = entries | split: '@@item@@' | sort -%}
      {%- for entry in sorted -%}
        {{- entry | split: '@@key@@' | last -}}
      {%- endfor -%}
    </ol>
  </div>
{%- endif -%}
