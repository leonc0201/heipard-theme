{%- comment -%}
  D4 Serienleiter: Längenstufen derselben Serie.

  Zwei Quellen, in dieser Reihenfolge:
    Varianten  Hat das Produkt Varianten und tragen mindestens zwei davon eine Länge in
               den Varianten-Metafeldern (heipard.gesamtlaenge_m, sonst beleuchtete_laenge_m,
               sonst hoehe_m), zeigt die Leiter die Varianten als Stufen, beschriftet mit
               dem Optionswert (Option Länge, Höhe oder Größe, sonst Variantentitel); die
               Länge aus dem Metafeld bestimmt Reihenfolge und Balken. Die gewählte
               Variante ist markiert, die Links wechseln die Variante (?variant=).
    Familie    Sonst alle aktiven Produkte der Familie (Produkt-Metafeld heipard.familie,
               Smart Collection "familie-<code>"), sortiert nach Gesamtlänge, sonst
               beleuchteter Länge. Das aktuelle Modell ist markiert.

  Rendert nichts, wenn es weder Variantenstufen noch Nachbarmodelle gibt.
  Parameter: product, kicker, title, body, label
{%- endcomment -%}
{%- liquid
  assign current = product.selected_or_first_available_variant
  assign mode = ''
  assign max_len = 0

  if product.has_only_default_variant == false
    assign with_len = 0
    for v in product.variants
      assign v_len = v.metafields.heipard.gesamtlaenge_m.value | default: v.metafields.heipard.beleuchtete_laenge_m.value | default: v.metafields.heipard.hoehe_m.value
      if v_len != blank
        assign with_len = with_len | plus: 1
        if v_len > max_len
          assign max_len = v_len
        endif
      endif
    endfor
    if with_len > 1
      assign mode = 'varianten'
      assign opt_index = -1
      assign size_options = 'Länge,Höhe,Größe' | split: ','
      for opt in product.options_with_values
        if opt_index < 0 and size_options contains opt.name
          assign opt_index = forloop.index0
        endif
      endfor
    endif
  endif

  assign familie = product.metafields.heipard.familie.value
  if mode == blank and familie != blank
    assign fam_handle = familie | handleize | prepend: 'familie-'
    assign fam = collections[fam_handle]
    assign others = 0
    assign max_len = 0
    for p in fam.products limit: 24
      if p.id != product.id
        assign others = others | plus: 1
      endif
      assign p_len = p.metafields.heipard.gesamtlaenge_m.value | default: p.metafields.heipard.beleuchtete_laenge_m.value
      if p_len != blank and p_len > max_len
        assign max_len = p_len
      endif
    endfor
    if others > 0
      assign mode = 'familie'
    endif
  endif

  assign default_kicker = 'heipard.blocks.serienleiter.kicker' | t
  assign default_title = 'heipard.blocks.serienleiter.title' | t
  assign head_kicker = kicker | default: default_kicker
  assign head_title = title | default: default_title
-%}
{%- if mode == blank -%}
  {%- if request.design_mode and familie == blank -%}
    <!--fb-note-->{{ 'heipard.blocks.editor.missing' | t: block: label, fields: 'heipard.familie' }}<!--fb-note-->
  {%- endif -%}
{%- else -%}
  {%- capture entries -%}
    {%- if mode == 'varianten' -%}
      {%- for v in product.variants -%}
        {%- liquid
          assign p_len = v.metafields.heipard.gesamtlaenge_m.value | default: v.metafields.heipard.beleuchtete_laenge_m.value | default: v.metafields.heipard.hoehe_m.value
          assign p_points = v.metafields.heipard.led_anzahl.value | default: product.metafields.heipard.led_anzahl.value
          assign p_url = product.url | append: '?variant=' | append: v.id
          assign p_price = v.price
          assign p_title = v.title
          assign p_label = v.title
          if opt_index >= 0
            assign p_label = v.options[opt_index]
          endif
          assign is_current = false
          if v.id == current.id
            assign is_current = true
          endif
        -%}
        {%- render 'heipard-fb-serienleiter-eintrag', p_len: p_len, p_points: p_points, p_url: p_url, p_price: p_price, p_title: p_title, p_label: p_label, is_current: is_current, max_len: max_len -%}
        {%- unless forloop.last -%}@@item@@{%- endunless -%}
      {%- endfor -%}
    {%- else -%}
      {%- for p in fam.products limit: 24 -%}
        {%- liquid
          assign p_len = p.metafields.heipard.gesamtlaenge_m.value | default: p.metafields.heipard.beleuchtete_laenge_m.value
          assign p_points = p.metafields.heipard.led_anzahl.value
          assign is_current = false
          if p.id == product.id
            assign is_current = true
          endif
        -%}
        {%- render 'heipard-fb-serienleiter-eintrag', p_len: p_len, p_points: p_points, p_url: p.url, p_price: p.price, p_title: p.title, is_current: is_current, max_len: max_len -%}
        {%- unless forloop.last -%}@@item@@{%- endunless -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endcapture -%}
  <div class="heipard-fb heipard-fb--serienleiter" data-heipard-serie="{{ mode }}">
    {%- render 'heipard-fb-head', kicker: head_kicker, title: head_title, body: body -%}
    <ol class="heipard-serie">
      {%- assign sorted = entries | split: '@@item@@' | sort -%}
      {%- for entry in sorted -%}
        {{- entry | split: '@@key@@' | last -}}
      {%- endfor -%}
    </ol>
  </div>
{%- endif -%}
