{%- comment -%}
  D4 Serienleiter: Längenstufen derselben Serie.

  Zwei Quellen, in dieser Reihenfolge:
    Varianten  Hat das Produkt Varianten und tragen mindestens zwei davon eine Länge in
               den Varianten-Metafeldern (heipard.beleuchtete_laenge_m, sonst gesamtlaenge_m,
               sonst hoehe_m; Teil L 1.3: die beleuchtete Länge wie im Titel), zeigt die Leiter die Varianten als Stufen, beschriftet mit
               dem Optionswert (Option Länge, Höhe oder Größe, sonst Variantentitel); die
               Länge aus dem Metafeld bestimmt Reihenfolge und Balken. Die gewählte
               Variante ist markiert, die Links wechseln die Variante (?variant=).
    Familie    Sonst alle aktiven Produkte der Familie (Produkt-Metafeld heipard.familie,
               Smart Collection "familie-<code>"), sortiert nach beleuchteter Länge, sonst
               Gesamtlänge. Das aktuelle Modell ist markiert.
               Teil M 1.12: Hat ein Nachbarmodell keine Länge am Produkt, aber Längen an
               seinen Varianten, zeigt die Karte die Spanne („30 bis 100 m“) und steht
               nach der kürzesten Länge in der Reihe.
               Nur gleiche Bauart (Auftrag Feature-Sektion dichter, 10.11.2026): Ein
               Nachbarmodell zählt nur, wenn sein Metafeld familie genau gleich ist und
               seine Stromquelle nicht abweicht (Netz, Batterie und Solar sind eigene
               Bauarten; fehlt die Stromquelle an einer Seite, entscheidet die Familie).
               So steht z. B. hp-dgm-048 (Batterie) nicht bei DGM-001/-002 (Netz).
    Teil N 3.2: Ist die angezeigte Zahl eine Gesamtlänge (keine beleuchtete Länge da), steht
               „gesamt“ dahinter (EN „total“), etwa „33 m gesamt“. Eine Spanne entsteht nur aus
               Werten derselben Art: Haben Varianten beleuchtete Längen, zählen nur diese;
               sonst die Gesamtlängen, dann mit Zusatz. Im Variantenmodus bekommt der
               Optionswert den Zusatz, wenn die Variante nur eine Gesamtlänge hat und der
               Optionswert genau diese Länge nennt. Die Sortierung bleibt.

  Rendert nichts, wenn es weder Variantenstufen noch Nachbarmodelle gibt.
  Parameter: product, kicker, title, body, label
{%- endcomment -%}
{%- liquid
  assign current = product.selected_or_first_available_variant
  assign mode = ''
  assign max_len = 0

  if product.has_only_default_variant == false
    assign with_len = 0
    for v in product.variants
      assign v_len = v.metafields.heipard.beleuchtete_laenge_m.value | default: v.metafields.heipard.gesamtlaenge_m.value | default: v.metafields.heipard.hoehe_m.value
      if v_len != blank
        assign with_len = with_len | plus: 1
        if v_len > max_len
          assign max_len = v_len
        endif
      endif
    endfor
    if with_len > 1
      assign mode = 'varianten'
      assign opt_index = -1
      # Teil N 3.2: auch die englischen Optionsnamen, sonst zeigt EN den ganzen Variantentitel.
      assign size_options = 'Länge,Höhe,Größe,Length,Height,Size' | split: ','
      for opt in product.options_with_values
        if opt_index < 0 and size_options contains opt.name
          assign opt_index = forloop.index0
        endif
      endfor
    endif
  endif

  assign familie = product.metafields.heipard.familie.value
  assign own_strom = product.metafields.heipard.stromquelle.value
  assign member_ids = ','
  if mode == blank and familie != blank
    assign fam_handle = familie | handleize | prepend: 'familie-'
    assign fam = collections[fam_handle]
    assign others = 0
    assign max_len = 0
    for p in fam.products limit: 24
      if p.id != product.id
        if p.metafields.heipard.familie.value != familie
          continue
        endif
        assign p_strom = p.metafields.heipard.stromquelle.value
        if own_strom != blank and p_strom != blank and p_strom != own_strom
          continue
        endif
        assign others = others | plus: 1
      endif
      assign member_ids = member_ids | append: p.id | append: ','
      assign p_len = p.metafields.heipard.beleuchtete_laenge_m.value | default: p.metafields.heipard.gesamtlaenge_m.value
      if p_len == blank
        for pv in p.variants
          assign pv_len = pv.metafields.heipard.beleuchtete_laenge_m.value | default: pv.metafields.heipard.gesamtlaenge_m.value
          if pv_len != blank and pv_len > max_len
            assign max_len = pv_len
          endif
        endfor
      endif
      if p_len != blank and p_len > max_len
        assign max_len = p_len
      endif
    endfor
    if others > 0
      assign mode = 'familie'
    endif
  endif

  assign default_kicker = 'heipard.blocks.serienleiter.kicker' | t
  assign default_title = 'heipard.blocks.serienleiter.title' | t
  assign head_kicker = kicker | default: default_kicker
  assign head_title = title | default: default_title
-%}
{%- if mode == blank -%}
  {%- if request.design_mode and familie == blank -%}
    <!--fb-note-->{{ 'heipard.blocks.editor.missing' | t: block: label, fields: 'heipard.familie' }}<!--fb-note-->
  {%- endif -%}
{%- else -%}
  {%- capture entries -%}
    {%- if mode == 'varianten' -%}
      {%- for v in product.variants -%}
        {%- liquid
          assign p_len = v.metafields.heipard.beleuchtete_laenge_m.value | default: v.metafields.heipard.gesamtlaenge_m.value | default: v.metafields.heipard.hoehe_m.value
          assign p_points = v.metafields.heipard.led_anzahl.value | default: product.metafields.heipard.led_anzahl.value
          assign p_url = product.url | append: '?variant=' | append: v.id
          assign p_price = v.price
          assign p_title = v.title
          assign p_label = v.title
          if opt_index >= 0
            assign p_label = v.options[opt_index]
            # Teil N 3.2: Optionswert nennt die Gesamtlänge, beleuchtete Länge fehlt.
            assign v_gl = v.metafields.heipard.gesamtlaenge_m.value
            if v.metafields.heipard.beleuchtete_laenge_m.value == blank and v_gl != blank
              capture v_gl_txt
                render 'heipard-num', value: v_gl
              endcapture
              assign v_gl_label = 'heipard.blocks.serienleiter.length' | t: value: v_gl_txt | replace: ' ', ''
              # Vergleich ohne Leerzeichen und geschützte Leerzeichen (EN-Optionswerte).
              assign p_cmp = p_label | replace: ' ', '' | replace: ' ', ''
              if p_cmp == v_gl_label
                assign p_label = 'heipard.blocks.serienleiter.length_total' | t: value: v_gl_txt
              endif
            endif
          endif
          assign is_current = false
          if v.id == current.id
            assign is_current = true
          endif
        -%}
        {%- render 'heipard-fb-serienleiter-eintrag', p_len: p_len, p_points: p_points, p_url: p_url, p_price: p_price, p_title: p_title, p_label: p_label, is_current: is_current, max_len: max_len -%}
        {%- unless forloop.last -%}@@item@@{%- endunless -%}
      {%- endfor -%}
    {%- else -%}
      {%- for p in fam.products limit: 24 -%}
        {%- liquid
          assign p_key = ',' | append: p.id | append: ','
          unless member_ids contains p_key
            continue
          endunless
          assign p_len = p.metafields.heipard.beleuchtete_laenge_m.value
          assign p_total = false
          if p_len == blank
            assign p_len = p.metafields.heipard.gesamtlaenge_m.value
            if p_len != blank
              assign p_total = true
            endif
          endif
          assign p_len_max = nil
          if p_len == blank
            # Teil M 1.12: Längen nur an den Varianten, Karte zeigt die Spanne.
            # Teil N 3.2: Spanne nur aus Werten derselben Art, beleuchtete Länge zuerst.
            assign l_min = nil
            assign l_max = nil
            assign g_min = nil
            assign g_max = nil
            for pv in p.variants
              assign pv_l = pv.metafields.heipard.beleuchtete_laenge_m.value
              assign pv_g = pv.metafields.heipard.gesamtlaenge_m.value
              if pv_l != blank
                if l_min == blank
                  assign l_min = pv_l
                  assign l_max = pv_l
                elsif pv_l < l_min
                  assign l_min = pv_l
                elsif pv_l > l_max
                  assign l_max = pv_l
                endif
              elsif pv_g != blank
                if g_min == blank
                  assign g_min = pv_g
                  assign g_max = pv_g
                elsif pv_g < g_min
                  assign g_min = pv_g
                elsif pv_g > g_max
                  assign g_max = pv_g
                endif
              endif
            endfor
            if l_min != blank
              assign p_len = l_min
              assign p_len_max = l_max
            elsif g_min != blank
              assign p_len = g_min
              assign p_len_max = g_max
              assign p_total = true
            endif
          endif
          assign p_points = p.metafields.heipard.led_anzahl.value
          assign is_current = false
          if p.id == product.id
            assign is_current = true
          endif
        -%}
        {%- render 'heipard-fb-serienleiter-eintrag', p_len: p_len, p_len_max: p_len_max, p_total: p_total, p_points: p_points, p_url: p.url, p_price: p.price, p_title: p.title, is_current: is_current, max_len: max_len -%}
        {%- unless forloop.last -%}@@item@@{%- endunless -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endcapture -%}
  <div class="heipard-fb heipard-fb--serienleiter" data-heipard-serie="{{ mode }}">
    {%- render 'heipard-fb-head', kicker: head_kicker, title: head_title, body: body -%}
    <ol class="heipard-serie">
      {%- assign sorted = entries | split: '@@item@@' | sort -%}
      {%- for entry in sorted -%}
        {{- entry | split: '@@key@@' | last -}}
      {%- endfor -%}
    </ol>
  </div>
{%- endif -%}
