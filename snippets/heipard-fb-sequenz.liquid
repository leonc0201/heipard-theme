{%- comment -%}
  P2 Sequenz: 3 bis 4 Bilder als Schrittfolge (aufhängen, Batterie einlegen,
  Solarpanel ausrichten, am Baum verteilen).

  Quellen:
    Bilder            Feld "Bildfolge" des Blocks, Reihenfolge = Schrittfolge.
                      Gleiche Perspektive und Lichtstimmung, 4:3.
    Bildunterschrift  je Schritt eine Zeile im Textfeld des Blocks
                      (Zeile 1 gehört zu Schritt 1, übersetzbar)

  Mindestens 2 Bilder, höchstens 4 werden gezeigt. Auf dem Handy lassen sich
  die Schritte seitlich durchwischen, ab Tablet stehen sie nebeneinander.

  Parameter: images, kicker, title, body, label
{%- endcomment -%}
{%- liquid
  assign lines = body | newline_to_br | split: '<br />'
  assign total = 0
  if images != blank
    assign total = images.size | at_most: 4
  endif
  assign default_kicker = 'heipard.blocks.sequenz.kicker' | t
  assign default_title = 'heipard.blocks.sequenz.title' | t
  assign head_kicker = kicker | default: default_kicker
  assign head_title = title | default: default_title
-%}
{%- if total < 2 -%}
  {%- if request.design_mode -%}
    <!--fb-note-->{{ 'heipard.blocks.editor.missing' | t: block: label, fields: 'Bildfolge (mindestens 2 Bilder)' }}<!--fb-note-->
  {%- endif -%}
{%- else -%}
  <div class="heipard-fb heipard-fb--sequenz">
    {%- render 'heipard-fb-head', kicker: head_kicker, title: head_title -%}
    <ol class="heipard-seq heipard-seq--{{ total }}">
      {%- for img in images limit: 4 -%}
        {%- liquid
          assign caption = lines[forloop.index0] | strip
          assign step_label = 'heipard.blocks.sequenz.step' | t: n: forloop.index
          assign alt_text = caption | default: step_label
        -%}
        <li class="heipard-seq__step">
          <div class="heipard-seq__media">
            {{
              img
              | image_url: width: 1000
              | image_tag:
                class: 'heipard-seq__img',
                loading: 'lazy',
                widths: '400, 600, 800, 1000',
                sizes: '(min-width: 750px) 33vw, 80vw',
                alt: alt_text
            }}
          </div>
          <p class="heipard-seq__caption">
            <span class="heipard-seq__num" aria-hidden="true">{{ forloop.index }}</span>
            <span>
              <span class="visually-hidden">{{ step_label }}: </span>
              {{- caption | escape -}}
            </span>
          </p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
{%- endif -%}
