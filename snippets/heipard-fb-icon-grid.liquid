{%- comment -%}
  B4 Icon-Grid aus Metafeldern: bis zu vier Kacheln mit Icon, Label und Kurzwert.

  Kachelregel (Auftrag Feature-Sektion dichter, 10.11.2026; Reihenfolge Leon 10.11.2026):
  Ohne Vorgabe zeigt der Block die ersten vier Kacheln, für die das Produkt Daten hat,
  in dieser Reihenfolge:
    timer, dimmbar, koppelbar, modi, fernbedienung, lichtpunkte, schutzart,
    lichtfarbe, stromquelle.
  Die Unterscheidungsmerkmale stehen vorn; Schutzart, Lichtfarbe und Stromquelle zeigt
  auch die Kaufbox, sie füllen nur auf.
  Kacheln ohne Wert werden übersprungen, ebenso Platzhalter (Wert beginnt mit "[TBD").
  Über das JSON-Feld des Blocks lässt sich die Auswahl festlegen (heute nirgends genutzt):
    { "kacheln": ["timer", "dimmbar", "koppelbar"] }

  Jedes Feld zuerst an der gewählten Variante, sonst am Produkt. Lichtfarbe zuerst aus
  der Variantenoption „Lichtfarbe“ (wie Spec-Kacheln und Technik).
  Parameter: product, data, label
{%- endcomment -%}
{%- liquid
  assign mf = product.metafields.heipard
  assign current = product.selected_or_first_available_variant
  assign vmf = current.metafields.heipard
  assign wanted = data.kacheln
  if wanted == blank
    assign wanted = 'timer,dimmbar,koppelbar,modi,fernbedienung,lichtpunkte,schutzart,lichtfarbe,stromquelle' | split: ','
  endif
  assign max_tiles = 4
  assign shown = 0
-%}
{%- capture tiles -%}
  {%- for key in wanted -%}
    {%- liquid
      if shown >= max_tiles
        break
      endif
      assign tile_label = ''
      assign tile_value = ''
      assign tile_icon = key
      assign timer_flag = false
      assign conn_flag = false
      case key
        when 'lichtfarbe'
          assign color = ''
          for opt in product.options_with_values
            if opt.name == 'Lichtfarbe'
              assign color = current.options[forloop.index0]
            endif
          endfor
          assign color = color | default: vmf.lichtfarbe.value | default: mf.lichtfarbe.value
          assign color_txt = color | append: '' | strip
          if color_txt != blank
            unless color_txt contains '[TBD'
              assign tile_label = 'heipard.blocks.icon_grid.light_color' | t
              assign tile_value = color_txt
            endunless
          endif
        when 'lichtpunkte'
          assign points = vmf.led_anzahl.value | default: mf.led_anzahl.value
          if points != blank and points > 0
            assign tile_label = 'heipard.blocks.icon_grid.light_points' | t
            capture tile_value
              render 'heipard-num', value: points
            endcapture
          endif
        when 'timer'
          assign hours = vmf.timer_dauer_h.value | default: mf.timer_dauer_h.value
          if hours != blank and hours.size > 0
            assign tile_label = 'heipard.blocks.icon_grid.timer' | t
            assign hours_txt = hours | sort | join: ' / '
            assign tile_value = 'heipard.blocks.icon_grid.timer_value' | t: hours: hours_txt
          else
            assign timer_flag = vmf.timer_funktion.value | default: mf.timer_funktion.value
          endif
          if tile_label == blank and timer_flag == true
            assign tile_label = 'heipard.blocks.icon_grid.timer' | t
          endif
        when 'schutzart'
          assign ip = vmf.ip_schutzart.value | default: mf.ip_schutzart.value
          assign ip_txt = ip | append: '' | strip
          if ip_txt != blank
            unless ip_txt contains '[TBD'
              assign tile_label = 'heipard.blocks.icon_grid.protection' | t
              assign tile_value = ip_txt
            endunless
          endif
        when 'stromquelle'
          assign power = vmf.stromquelle.value | default: mf.stromquelle.value
          assign power_txt = power | append: '' | strip
          if power_txt != blank
            unless power_txt contains '[TBD'
              assign tile_label = 'heipard.blocks.icon_grid.power_source' | t
              assign tile_value = power_txt
              assign power_down = power_txt | downcase
              if power_down contains 'solar'
                assign tile_icon = 'sonne'
              elsif power_down contains 'batterie' or power_down contains 'akku'
                assign tile_icon = 'batterie'
              else
                assign tile_icon = 'stecker'
              endif
            endunless
          endif
        when 'fernbedienung'
          assign remote_flag = vmf.fernbedienung.value | default: mf.fernbedienung.value
          if remote_flag == true
            assign tile_label = 'heipard.blocks.icon_grid.remote' | t
          endif
        when 'modi'
          assign modes = vmf.anzahl_leuchtmodi.value | default: mf.anzahl_leuchtmodi.value
          if modes != blank and modes > 1
            assign tile_label = 'heipard.blocks.icon_grid.modes' | t
            assign tile_value = 'heipard.blocks.icon_grid.modes_value' | t: count: modes
          endif
        when 'dimmbar'
          assign levels = vmf.dimmstufen.value | default: mf.dimmstufen.value
          assign level_count = vmf.dimmstufen_anzahl.value | default: mf.dimmstufen_anzahl.value
          if levels != blank and levels.size > 1
            assign tile_label = 'heipard.blocks.icon_grid.dimmable' | t
            assign tile_value = 'heipard.blocks.icon_grid.dimmable_value' | t: count: levels.size
          elsif level_count != blank and level_count > 1
            assign tile_label = 'heipard.blocks.icon_grid.dimmable' | t
            assign tile_value = 'heipard.blocks.icon_grid.dimmable_value' | t: count: level_count
          endif
        when 'koppelbar'
          assign chains = vmf.koppelbar_bis.value | default: mf.koppelbar_bis.value
          if chains != blank and chains > 1
            assign tile_label = 'heipard.blocks.icon_grid.connectable' | t
            assign tile_value = 'heipard.blocks.icon_grid.connectable_value' | t: count: chains
          else
            assign conn_flag = vmf.connectable.value | default: mf.connectable.value
          endif
          if tile_label == blank and conn_flag == true
            assign tile_label = 'heipard.blocks.icon_grid.connectable' | t
          endif
      endcase
      assign tile_value = tile_value | strip
    -%}
    {%- if tile_label != blank -%}
      {%- assign shown = shown | plus: 1 -%}
      <li class="heipard-feature__mini" data-kachel="{{ key }}">
        <span class="heipard-feature__mini-icon" aria-hidden="true">{%- render 'heipard-fb-icon', name: tile_icon -%}</span>
        <span class="heipard-feature__mini-text">
          <span class="heipard-feature__mini-label">{{ tile_label }}</span>
          {%- if tile_value != blank -%}
            <span class="heipard-feature__mini-desc">{{ tile_value | escape }}</span>
          {%- endif -%}
        </span>
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if shown > 0 -%}
  <ul class="heipard-feature__minis heipard-feature__minis--block heipard-feature__minis--{{ shown }}">
    {{- tiles -}}
  </ul>
{%- elsif request.design_mode -%}
  <!--fb-note-->{{ 'heipard.blocks.editor.missing' | t: block: label, fields: 'heipard.lichtfarbe, heipard.led_anzahl, heipard.timer_dauer_h, heipard.ip_schutzart, heipard.stromquelle' }}<!--fb-note-->
{%- endif -%}
