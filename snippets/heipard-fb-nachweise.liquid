{%- comment -%}
  D5 Nachweise: Schutzart erklärt, Betriebsspannung, CE. Aufklappbar.
  Steht immer in der Daten-Zone. Nur aus Metafeldern.

  Quellen (jede Zeile erscheint nur, wenn der Wert gepflegt ist):
    heipard.ip_schutzart       z. B. "IP45". Die Erklärung je Ziffer kommt aus den
                               Locales (heipard.blocks.nachweise.ip_first / ip_second).
    heipard.spannung_v         Zeile nur bei Kleinspannung (bis 50 V)
    heipard.ce_kennzeichnung   Wahr/Falsch

  Parameter: product, kicker, title, body, label
{%- endcomment -%}
{%- liquid
  assign mf = product.metafields.heipard
  assign vmf = product.selected_or_first_available_variant.metafields.heipard
  assign ip = vmf.ip_schutzart.value | default: mf.ip_schutzart.value
  assign volt = vmf.spannung_v.value | default: mf.spannung_v.value
  assign ce = vmf.ce_kennzeichnung.value | default: mf.ce_kennzeichnung.value

  assign has_ip = false
  if ip != blank
    assign digits = ip | upcase | remove: 'IP' | strip
    assign d1 = digits | slice: 0
    assign d2 = digits | slice: 1
    if d1 != blank and d2 != blank
      if '0123456' contains d1 and '012345678' contains d2
        assign has_ip = true
        assign ip_first_key = 'heipard.blocks.nachweise.ip_first.' | append: d1
        assign ip_second_key = 'heipard.blocks.nachweise.ip_second.' | append: d2
      endif
    endif
  endif

  assign has_volt = false
  if volt != blank and volt > 0 and volt <= 50
    assign has_volt = true
    capture volt_txt
      render 'heipard-num', value: volt
    endcapture
  endif

  assign has_ce = false
  if ce == true
    assign has_ce = true
  endif

  assign default_kicker = 'heipard.blocks.nachweise.kicker' | t
  assign default_title = 'heipard.blocks.nachweise.title' | t
  assign head_kicker = kicker | default: default_kicker
  assign head_title = title | default: default_title
-%}
{%- if has_ip or has_volt or has_ce -%}
  <div class="heipard-fb heipard-fb--nachweise">
    {%- render 'heipard-fb-head', kicker: head_kicker, title: head_title, body: body -%}
    <div class="heipard-acc">
      {%- if has_ip -%}
        <details class="heipard-acc__item">
          <summary class="heipard-acc__summary">{{ 'heipard.blocks.nachweise.ip_title' | t: value: ip }}</summary>
          <div class="heipard-acc__body">
            <p>{{ 'heipard.blocks.nachweise.ip_intro' | t }}</p>
            <ul>
              <li><strong>{{ d1 }}</strong> {{ ip_first_key | t }}</li>
              <li><strong>{{ d2 }}</strong> {{ ip_second_key | t }}</li>
            </ul>
          </div>
        </details>
      {%- endif -%}
      {%- if has_volt -%}
        <details class="heipard-acc__item">
          <summary class="heipard-acc__summary">{{ 'heipard.blocks.nachweise.voltage_title' | t: value: volt_txt }}</summary>
          <div class="heipard-acc__body">
            <p>{{ 'heipard.blocks.nachweise.voltage_low' | t }}</p>
          </div>
        </details>
      {%- endif -%}
      {%- if has_ce -%}
        <details class="heipard-acc__item">
          <summary class="heipard-acc__summary">{{ 'heipard.blocks.nachweise.ce_title' | t }}</summary>
          <div class="heipard-acc__body">
            <p>{{ 'heipard.blocks.nachweise.ce_text' | t }}</p>
          </div>
        </details>
      {%- endif -%}
    </div>
  </div>
{%- elsif request.design_mode -%}
  <!--fb-note-->{{ 'heipard.blocks.editor.missing' | t: block: label, fields: 'heipard.ip_schutzart, heipard.spannung_v, heipard.ce_kennzeichnung' }}<!--fb-note-->
{%- endif -%}
