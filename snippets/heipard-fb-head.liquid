{%- comment -%}
  Kopf eines Baukasten-Blocks: Kicker, Titel, optional ein kurzer Text.
  Parameter: kicker, title, body (alle optional)
{%- endcomment -%}
{%- if kicker != blank or title != blank or body != blank -%}
  <div class="heipard-fb__head">
    {%- if kicker != blank -%}<span class="heipard-feature__eyebrow">{{ kicker | escape }}</span>{%- endif -%}
    {%- if title != blank -%}<h3 class="heipard-feature__title">{{ title | escape }}</h3>{%- endif -%}
    {%- if body != blank -%}<p class="heipard-feature__body">{{ body | escape | newline_to_br }}</p>{%- endif -%}
  </div>
{%- endif -%}
