{%- comment -%}
  Ein Eintrag der Serienleiter (D4). Gibt einen Sortierschlüssel, "@@key@@" und das
  <li> aus; die Serienleiter sortiert die Einträge über den Schlüssel.
  Parameter: p_len (Nennlänge in m oder blank), p_len_max (optional, Teil M 1.12: obere Grenze
             der Spanne bei Längen nur an den Varianten; sortiert wird nach p_len),
             p_total (optional, Teil N 3.2: true, wenn p_len und p_len_max Gesamtlängen sind;
             dann steht „gesamt“ bzw. „total“ hinter der Zahl oder Spanne;
             Teil P 5: auch der Text 'true'),
             p_points, p_url, p_price (Cent),
             p_title, p_label (optional: Beschriftung statt der Länge, z. B. Optionswert),
             is_current, max_len,
             p_rang (Teil Q 5: Position in Familie bzw. Variantenliste; bei gleichem Maß bleibt die
             Reihenfolge so auf jeder Seite gleich, statt dass die aktuelle Karte nach vorn rutscht)
{%- endcomment -%}
{%- liquid
  assign sort_key = '99999999'
  assign share = 100
  if p_len != blank
    assign sort_key = p_len | times: 100 | round | prepend: '00000000' | slice: -8, 8
    assign bar_len = p_len_max | default: p_len
    if max_len > 0
      assign share = bar_len | times: 100.0 | divided_by: max_len | round
    endif
  endif
  assign rang = p_rang | default: 0 | prepend: '000' | slice: -3, 3
  assign sort_key = sort_key | append: rang
-%}
{{- sort_key -}}@@key@@
<li class="heipard-serie__item{% if is_current %} is-current{% endif %}">
  <a class="heipard-serie__link" href="{{ p_url }}"{% if is_current %} aria-current="page"{% endif %}>
    <span class="heipard-serie__bar" style="--share: {{ share }}%;" aria-hidden="true"></span>
    <span class="heipard-serie__length">
      {%- if p_label != blank -%}
        {{- p_label | escape -}}
      {%- elsif p_len != blank and p_len_max != blank and p_len_max != p_len -%}
        {%- capture p_min_txt -%}{%- render 'heipard-num', value: p_len -%}{%- endcapture -%}
        {%- capture p_max_txt -%}{%- render 'heipard-num', value: p_len_max -%}{%- endcapture -%}
        {%- if p_total == true or p_total == 'true' -%}
          {{- 'heipard.blocks.serienleiter.range_total' | t: min: p_min_txt, max: p_max_txt -}}
        {%- else -%}
          {{- 'heipard.blocks.serienleiter.range' | t: min: p_min_txt, max: p_max_txt -}}
        {%- endif -%}
      {%- elsif p_len != blank -%}
        {%- capture p_len_txt -%}{%- render 'heipard-num', value: p_len -%}{%- endcapture -%}
        {%- if p_total == true or p_total == 'true' -%}
          {{- 'heipard.blocks.serienleiter.length_total' | t: value: p_len_txt -}}
        {%- else -%}
          {{- 'heipard.blocks.serienleiter.length' | t: value: p_len_txt -}}
        {%- endif -%}
      {%- else -%}
        {{- p_title | escape -}}
      {%- endif -%}
    </span>
    {%- if p_points != blank and p_points > 0 -%}
      <span class="heipard-serie__meta">{{ 'heipard.blocks.kettenplan.points' | t: count: p_points }}</span>
    {%- endif -%}
    {%- unless settings.showroom_mode -%}
      <span class="heipard-serie__meta heipard-serie__price">{{ p_price | money }}</span>
    {%- endunless -%}
    {%- if is_current -%}
      <span class="heipard-serie__flag">{{ 'heipard.blocks.serienleiter.current' | t }}</span>
    {%- elsif p_len != blank -%}
      <span class="visually-hidden">{{ p_title | escape }}</span>
    {%- endif -%}
  </a>
</li>
