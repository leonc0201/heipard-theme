{% comment %}
  HeiPard Desktop-Navigation mit Mega-Panel (Hue-Niveau).
  Top-Level-Links inline. Ein Punkt MIT Kindern (aktuell "Lichterketten") öffnet
  ein Mega-Panel über die volle Breite (Panel-Hintergrund edge-to-edge, Inhalt
  auf page-width zentriert):
    - links 6 Unterkategorie-Karten (Bild + Name + Beschreibung + Produktanzahl)
    - rechts eine Highlight-Bildkachel (Header-Setting mega_highlight_*)
    - Fuß: klare "Alle … ansehen"-CTA
  Bild je Karte dynamisch: Featured Image der Kollektion, sonst erstes Produktfoto.
  Öffnet per Hover UND Tastatur (:focus-within), reines CSS.

  Desktop-only: Mobil rendert header-drawer.liquid (unberührt).
  CSS global in assets/heipard-header.css (nach base.css).
{% endcomment %}
<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline heipard-nav" role="list">
    {%- for link in section.settings.menu.links -%}
      {%- if link.links != blank -%}
        <li class="heipard-nav__item heipard-nav__item--mega">
          <a
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link heipard-nav__trigger{% if link.current or link.child_active %} heipard-nav__trigger--active{% endif %}"
          >
            <span>{{ link.title | escape }}</span>
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </a>

          <div class="heipard-mega" role="group" aria-label="{{ link.title | escape }}">
            <div class="heipard-mega__inner page-width">
              <div class="heipard-mega__cols">
                <ul class="heipard-mega__grid" role="list">
                  {%- for childlink in link.links -%}
                    {%- liquid
                      assign col = childlink.object
                      assign thumb = null
                      if col.image != blank
                        assign thumb = col.image
                      elsif col.products.first.featured_image != blank
                        assign thumb = col.products.first.featured_image
                      endif
                    -%}
                    <li class="heipard-mega__cell">
                      <a href="{{ childlink.url }}" class="heipard-mega__card">
                        <span class="heipard-mega__thumb">
                          {%- if thumb != blank -%}
                            {{
                              thumb
                              | image_url: width: 200
                              | image_tag:
                                class: 'heipard-mega__img',
                                loading: 'lazy',
                                widths: '96, 140, 200',
                                sizes: '5.6rem',
                                alt: childlink.title
                            }}
                          {%- else -%}
                            <span class="heipard-mega__img heipard-mega__fallback" aria-hidden="true"></span>
                          {%- endif -%}
                        </span>
                        <span class="heipard-mega__text">
                          <span class="heipard-mega__name">{{ childlink.title | escape }}</span>
                          <span class="heipard-mega__desc">
                            {%- case col.handle -%}
                              {%- when 'led-string-lights' -%}Der Allrounder für drinnen & draußen
                              {%- when 'christmas-tree-lights' -%}Für den Baum gemacht
                              {%- when 'curtain' -%}Lichtervorhänge für Fenster & Wände
                              {%- when 'icicle' -%}Eiszapfen-Effekt für Dach & Fassade
                              {%- when 'cluster' -%}Dichte Lichtpunkte, voller Effekt
                              {%- when 'net' -%}Lichternetze für Hecke & Busch
                            {%- endcase -%}
                          </span>
                          {%- if col.all_products_count > 0 -%}
                            <span class="heipard-mega__count">
                              {{ col.all_products_count }}
                              {%- if col.all_products_count == 1 %} Produkt{% else %} Produkte{% endif -%}
                            </span>
                          {%- endif -%}
                        </span>
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>

                {%- if section.settings.mega_highlight_image != blank -%}
                  <a class="heipard-mega__highlight" href="{{ section.settings.mega_highlight_link | default: link.url }}">
                    {{
                      section.settings.mega_highlight_image
                      | image_url: width: 760
                      | image_tag:
                        class: 'heipard-mega__highlight-img',
                        loading: 'lazy',
                        widths: '360, 540, 760',
                        sizes: '(min-width: 990px) 30vw, 90vw',
                        alt: section.settings.mega_highlight_heading | default: 'Bestseller entdecken'
                    }}
                    <span class="heipard-mega__highlight-scrim" aria-hidden="true"></span>
                    <span class="heipard-mega__highlight-content">
                      <span class="heipard-mega__highlight-heading">{{ section.settings.mega_highlight_heading | default: 'Bestseller entdecken' | escape }}</span>
                      <span class="heipard-mega__highlight-cta" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
                      </span>
                    </span>
                  </a>
                {%- endif -%}
              </div>

              <a href="{{ link.url }}" class="heipard-mega__all">
                Alle {{ link.title | escape }} ansehen
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
              </a>
            </div>
          </div>
        </li>
      {%- else -%}
        <li class="heipard-nav__item">
          <a
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link heipard-nav__trigger{% if link.current %} heipard-nav__trigger--active{% endif %}"
          >
            <span>{{ link.title | escape }}</span>
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</nav>
