{% comment %}
  HeiPard PDP Feature — rendert EINEN Medien-Block: B1 Full-Width oder B2 Split,
  jeweils mit Bild oder Video (B3).
  Genutzt für beide Quellen -> ein Markup, ein CSS:
    - Metaobjekt-Blöcke über snippets/heipard-feature-dispatch.liquid
    - alte Section-Blocks direkt aus sections/heipard-feature.liquid

  Parameter:
    layout       'media_text' (alternierende Bild/Text-Zeile) | 'fullwidth' (Voll-Breite-Anker)
    media_type   'image' | 'video'
    image        Bild-Objekt (optional; bei Video zugleich Video-Poster)
    video        Datei-/Video-Objekt (MP4/WebM; optional)
    kicker       String (optional)
    title        String (optional)
    body         String (optional; Zeilenumbrüche werden zu <br>)
    index        laufende Nummer der media_text-Zeilen (für Auto-Alternation)
    media_side   'auto' | 'left' | 'right'   (nur media_text)
    overlay_theme 'light' | 'dark'           (nur fullwidth: Textfarbe des Overlays)
    variant      'sticky' (nur media_text): ab Desktop bleibt das Bild stehen, die
                 Textpunkte ziehen vorbei. Jede Zeile im Text ist ein Punkt,
                 optional mit Titel davor: "Titel | Text".
                 'r1' (nur media_text): R1-Text mit Bild aus der Block-Weiche, Klasse
                 heipard-feature__row--r1, sonst wie B2.
                 'szene' (nur media_text): Szenenbild R2/R3 aus der Block-Weiche, Klasse
                 heipard-feature__row--szene (Bild 16:9), Alt wie R1.
                 'zusatz' (nur media_text): Zusatzzeile mit Bild am Block, Klasse
                 heipard-feature__row--zusatz, Bildformat wie B2, Alt wie R1.
    alt          Alt-Text aus dem Blockfeld alt (übersetzbar, DE und EN aus dem Alt der Datei in
                 Files). Hat Vorrang. Fehlt er: R1 nimmt den Alt der Datei, sonst die Überschrift;
                 B1 und B2 nehmen die Überschrift, sonst den Alt der Datei. Der Alt der Datei kommt
                 in Liquid nur in der Hauptsprache an (geprüft 16.11.2026), daher das Blockfeld.
    clip_once    Video-Objekt (optional, nur mit Bild): läuft einmal je Seitenaufruf und endet auf dem Bild
    clip_loop    Video-Objekt (optional, nur mit Bild): Schleife, erstes und letztes Bild gleich dem Bild
                 Beide liegen stumm und ohne Bedienelemente über dem Bild, das Startbild, größtes Element
                 und Ersatz bleibt. Abspielen steuert assets/heipard-feature.js (initClip): Laden erst nahe
                 am Sichtfeld, Start ab halber Sichtbarkeit, höchstens ein Clip zugleich, kein Clip bei
                 reduzierter Bewegung, Datensparmodus oder langsamer Verbindung (3G und schlechter); Start erst, wenn genug gepuffert ist. Auftrag Teil H, 22.11.2026.
                 Teil I: Liegt das erste Bild von „einmal“ bereit, bevor der Block halb sichtbar ist, deckt der
                 angehaltene Clip das Bild schon ab („dunkel, an“); sonst entfällt „einmal“ für diesen Aufruf.
    clip_once_m  Mobil-Fassungen (optional, Video oder MP4-Datei). Auf schmalen Bildschirmen läuft ein Clip
    clip_loop_m  nur mit Mobil-Fassung, außer clip_ersatz ist wahr (dann die große Fassung).
    clip_ersatz  true: auf schmalen Bildschirmen ohne Mobil-Fassung die große Fassung nutzen.
{% endcomment %}
{%- liquid
  assign layout = layout | default: 'media_text'
  assign media_type = media_type | default: 'image'
  assign index = index | default: 1
  assign media_side = media_side | default: 'auto'
  assign overlay_theme = overlay_theme | default: 'light'
  if layout == 'fullwidth'
    assign img_sizes = '(min-width: 1400px) 1400px, 100vw'
  else
    assign img_sizes = '(min-width: 750px) 50vw, 100vw'
  endif
  assign img_alt = title | default: image.alt
  if variant == 'r1' or variant == 'szene' or variant == 'zusatz'
    assign img_alt = image.alt | default: title
  endif
  if alt != blank
    assign img_alt = alt
  endif
-%}

{%- capture media_html -%}
  {%- if media_type == 'video' and video != blank -%}
    <video
      class="heipard-feature__media-el"
      autoplay
      loop
      muted
      playsinline
      preload="metadata"
      {% if image != blank %}poster="{{ image | image_url: width: 1400 }}"{% endif %}
      aria-hidden="true"
    >
      {%- if video.sources -%}
        {%- for s in video.sources -%}
          {%- if s.format == 'mp4' or s.format == 'webm' -%}
            <source src="{{ s.url }}" type="video/{{ s.format }}">
          {%- endif -%}
        {%- endfor -%}
      {%- elsif video.url -%}
        <source src="{{ video.url }}">
      {%- endif -%}
    </video>
  {%- elsif image != blank -%}
    {{
      image
      | image_url: width: 1400
      | image_tag:
        class: 'heipard-feature__media-el',
        loading: 'lazy',
        widths: '500, 750, 1000, 1200, 1400',
        sizes: img_sizes,
        alt: img_alt
    }}
    {%- if clip_once != blank or clip_loop != blank or clip_once_m != blank or clip_loop_m != blank -%}
      {%- liquid
        # Je Clip die Fassungen als JSON (h = Höhe, w = Breite, u = Adresse), groß und mobil, dazu die
        # HLS-Adresse für den Gerätetest (?clip_hls=1). Das Skript wählt nach Bildschirmbreite.
        # Schlüssel aus den Datei-IDs: beim Variantenwechsel übernimmt heipard-variant.js das laufende
        # Element, statt neu zu starten.
        assign clip_key = clip_once.id | append: '-' | append: clip_loop.id | append: '-' | append: clip_once_m.id | append: '-' | append: clip_loop_m.id
        capture once_json
          render 'heipard-clip-json', f: clip_once
        endcapture
        capture loop_json
          render 'heipard-clip-json', f: clip_loop
        endcapture
        capture once_m_json
          render 'heipard-clip-json', f: clip_once_m
        endcapture
        capture loop_m_json
          render 'heipard-clip-json', f: clip_loop_m
        endcapture
        capture once_hls
          render 'heipard-clip-json', f: clip_once, mode: 'hls'
        endcapture
        capture loop_hls
          render 'heipard-clip-json', f: clip_loop, mode: 'hls'
        endcapture
        assign once_json = once_json | strip
        assign loop_json = loop_json | strip
        assign once_m_json = once_m_json | strip
        assign loop_m_json = loop_m_json | strip
        assign once_hls = once_hls | strip
        assign loop_hls = loop_hls | strip
      -%}
      {%- if once_json != blank or loop_json != blank or once_m_json != blank or loop_m_json != blank -%}
        <video
          class="heipard-feature__media-el heipard-clip"
          data-heipard-clip="{{ clip_key }}"
          {% if once_json != blank %}data-clip-once="[{{ once_json | escape }}]"{% endif %}
          {% if loop_json != blank %}data-clip-loop="[{{ loop_json | escape }}]"{% endif %}
          {% if once_m_json != blank %}data-clip-once-m="[{{ once_m_json | escape }}]"{% endif %}
          {% if loop_m_json != blank %}data-clip-loop-m="[{{ loop_m_json | escape }}]"{% endif %}
          {% if once_hls != blank %}data-clip-once-hls="[{{ once_hls | escape }}]"{% endif %}
          {% if loop_hls != blank %}data-clip-loop-hls="[{{ loop_hls | escape }}]"{% endif %}
          {% if clip_ersatz %}data-clip-ersatz="true"{% endif %}
          muted
          playsinline
          webkit-playsinline
          disablepictureinpicture
          disableremoteplayback
          preload="none"
          aria-hidden="true"
          tabindex="-1"
        ></video>
      {%- endif -%}
    {%- endif -%}
  {%- else -%}
    <span class="heipard-feature__media-el heipard-feature__fallback" aria-hidden="true"></span>
  {%- endif -%}
{%- endcapture -%}

{%- capture text_html -%}
  {%- if kicker != blank -%}<span class="heipard-feature__eyebrow">{{ kicker | escape }}</span>{%- endif -%}
  {%- if title != blank -%}<h3 class="heipard-feature__title">{{ title | escape }}</h3>{%- endif -%}
  {%- if body != blank -%}<p class="heipard-feature__body">{{ body | escape | newline_to_br }}</p>{%- endif -%}
{%- endcapture -%}

{%- if layout == 'fullwidth' -%}
  {%- assign has_text = false -%}
  {%- if kicker != blank or title != blank or body != blank -%}{%- assign has_text = true -%}{%- endif -%}
  <div class="heipard-feature__full heipard-feature__full--{{ overlay_theme }}">
    <div class="heipard-feature__full-media">{{ media_html }}</div>
    {%- if has_text -%}
      <span class="heipard-feature__full-scrim" aria-hidden="true"></span>
      <div class="heipard-feature__full-content">{{ text_html }}</div>
    {%- endif -%}
  </div>
{%- else -%}
  {%- liquid
    assign reverse = false
    if media_side == 'right'
      assign reverse = true
    elsif media_side == 'auto'
      assign parity = index | modulo: 2
      if parity == 0
        assign reverse = true
      endif
    endif
  -%}
  {%- liquid
    assign is_sticky = false
    if variant == 'sticky' and body != blank
      assign is_sticky = true
    endif
  -%}
  <div class="heipard-feature__row{% if reverse %} heipard-feature__row--reverse{% endif %}{% if is_sticky %} heipard-feature__row--sticky{% endif %}{% if variant == 'r1' %} heipard-feature__row--r1{% endif %}{% if variant == 'szene' %} heipard-feature__row--szene{% endif %}{% if variant == 'zusatz' %} heipard-feature__row--zusatz{% endif %}">
    <div class="heipard-feature__media">{{ media_html }}</div>
    <div class="heipard-feature__text">
      {%- if is_sticky -%}
        {%- if kicker != blank -%}<span class="heipard-feature__eyebrow">{{ kicker | escape }}</span>{%- endif -%}
        {%- if title != blank -%}<h3 class="heipard-feature__title">{{ title | escape }}</h3>{%- endif -%}
        <ol class="heipard-feature__points">
          {%- assign points = body | newline_to_br | split: '<br />' -%}
          {%- for point in points -%}
            {%- liquid
              assign line = point | strip
              if line == blank
                continue
              endif
              assign parts = line | split: ' | '
            -%}
            <li class="heipard-feature__point">
              {%- if parts.size > 1 -%}
                <h4 class="heipard-feature__point-title">{{ parts[0] | escape }}</h4>
                <p class="heipard-feature__body">{{ parts[1] | escape }}</p>
              {%- else -%}
                <p class="heipard-feature__body">{{ line | escape }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ol>
      {%- else -%}
        {{- text_html -}}
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
