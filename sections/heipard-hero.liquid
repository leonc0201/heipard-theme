{% comment %}
  HeiPard Hero — Startseiten-Aufmacher
  Vollbild-Abendszene, weiße Headline + Akzentwort, Saison-Badge, 2 CTAs.
  Optik 1:1 aus docs/lovable-reference Abschnitt 4.
  Bild über Section-Setting (Customizer); ohne Bild zeigt ein warmer
  Token-Verlauf als Fallback.

  Lichtschalter schaltet das Bild (Auftrag Teil H, Abschnitt 3, Vorschau): Einstellung
  „Bild je Modus“ (switch_mode)
    aus         nur das Abendbild wie bisher (Standard)
    bilder      Fassung 1: Tagbild im Tag-Modus, Abendbild in der Abendstimmung, weicher Wechsel
    clip        Fassung 2: wie 1, beim Umschalten läuft der passende Clip (an bzw. aus)
    clip_intro  Fassung 3: wie 2, dazu beim ersten Aufruf je Sitzung in der Abendstimmung
                einmal der Clip „Licht an“ von selbst
  data-bild (tag | abend) am Abschnitt steuert, welches Bild sichtbar ist; ein Inline-Skript setzt es
  vor dem ersten Bild aus data-theme. Abspielen: assets/heipard-hero.js. Bei reduzierter Bewegung
  oder Datensparmodus kein Clip, nur der Bildwechsel. Nur in unveröffentlichten Themes lässt sich die
  Fassung über ?hero_fassung=1|2|3 in der Adresse wählen (Vorschau für Leon).

  Teil I (22.11.2026, Vorschau): Mobil-Fassungen unter 750 px, Tempo normal oder schnell (Einstellung
  tempo, Vorschau ?hero_tempo=), Tag-Modus aus, hinweis oder intro (Einstellung tag_modus, Vorschau
  ?hero_tag=). Ablauf siehe assets/heipard-hero.js.
{% endcomment %}

{%- liquid
  assign hero_mode = section.settings.switch_mode | default: 'aus'
  if section.settings.image_day == blank
    assign hero_mode = 'aus'
  endif
  assign hero_clips = false
  if hero_mode == 'clip' or hero_mode == 'clip_intro'
    assign hero_clips = true
  endif
  assign on_json = ''
  assign off_json = ''
  if hero_clips
    # Je Clip die Fassungen als JSON: normal und schnell, groß und mobil (Teil I, Abschnitt 7.2).
    capture on_json
      render 'heipard-clip-json', f: section.settings.clip_on
    endcapture
    capture off_json
      render 'heipard-clip-json', f: section.settings.clip_off
    endcapture
    capture on_m_json
      render 'heipard-clip-json', f: section.settings.clip_on_m
    endcapture
    capture off_m_json
      render 'heipard-clip-json', f: section.settings.clip_off_m
    endcapture
    capture on_s_json
      render 'heipard-clip-json', f: section.settings.clip_on_schnell
    endcapture
    capture off_s_json
      render 'heipard-clip-json', f: section.settings.clip_off_schnell
    endcapture
    capture on_sm_json
      render 'heipard-clip-json', f: section.settings.clip_on_schnell_m
    endcapture
    capture off_sm_json
      render 'heipard-clip-json', f: section.settings.clip_off_schnell_m
    endcapture
    assign on_json = on_json | strip
    assign off_json = off_json | strip
    assign on_m_json = on_m_json | strip
    assign off_m_json = off_m_json | strip
    assign on_s_json = on_s_json | strip
    assign off_s_json = off_s_json | strip
    assign on_sm_json = on_sm_json | strip
    assign off_sm_json = off_sm_json | strip
  endif
-%}

<section
  class="heipard-hero{% if hero_mode != 'aus' %} heipard-hero--modus{% endif %}"
  style="--heipard-hero-min-height: {{ section.settings.min_height }}px; --hero-pos-mobile: {{ section.settings.mobile_position }}% 50%; --hero-tag-scrim: {{ section.settings.day_scrim | divided_by: 100.0 }};"
  data-heipard-hero
  data-mode="{{ hero_mode }}"
  data-clips="{% if hero_clips and on_json != blank and off_json != blank %}true{% else %}false{% endif %}"
  data-tempo="{{ section.settings.tempo | default: 'normal' }}"
  data-tag="{{ section.settings.tag_modus | default: 'aus' }}"
  data-text-an="{{ 'heipard.hero.hinweis_an' | t | escape }}"
  data-text-aus="{{ 'heipard.hero.hinweis_aus' | t | escape }}"
  data-bild="abend"
>
  {%- if hero_mode != 'aus' -%}
    <script>
      (function (s) {
        var mode = s.getAttribute('data-mode');
        try {
          // Vorschau, nur in unveröffentlichten Themes: ?hero_fassung=1|2|3, ?hero_tempo=normal|schnell,
          // ?hero_tag=aus|hinweis|intro (Teil I, Abschnitte 7.2 und 7.3).
          var q = new URLSearchParams(location.search);
          var role = window.Shopify && Shopify.theme && Shopify.theme.role;
          if (role && role !== 'main') {
            var f = { '1': 'bilder', '2': 'clip', '3': 'clip_intro' }[q.get('hero_fassung')];
            if (f) { mode = f; s.setAttribute('data-mode', mode); }
            var t = q.get('hero_tempo');
            if (t === 'normal' || t === 'schnell') s.setAttribute('data-tempo', t);
            var g = q.get('hero_tag');
            if (g === 'aus' || g === 'hinweis' || g === 'intro') s.setAttribute('data-tag', g);
          }
        } catch (e) {}
        var dark = document.documentElement.getAttribute('data-theme') === 'dark';
        var intro = '';
        if (mode === 'clip_intro' && s.getAttribute('data-clips') === 'true') {
          var c = navigator.connection;
          var seen = null;
          try { seen = sessionStorage.getItem('heipard-hero-intro'); } catch (e) {}
          var slow = !!(c && (c.saveData || /(^|-)(2g|3g)$/.test(c.effectiveType || '')));
          var ok = !seen && !slow && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          // Abendstimmung: Intro „Licht an“ (Fassung 3). Tag-Modus nur mit Option intro (7.3 b).
          if (ok && dark) intro = 'abend';
          else if (ok && s.getAttribute('data-tag') === 'intro') intro = 'tag';
        }
        if (intro) s.setAttribute('data-intro', intro);
        s.setAttribute('data-bild', intro || !dark ? 'tag' : 'abend');
      })(document.currentScript.parentNode);
    </script>
  {%- endif -%}
  {%- if section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 3840
      | image_tag:
        class: 'heipard-hero__image heipard-hero__image--abend',
        loading: 'eager',
        fetchpriority: 'high',
        sizes: '100vw',
        widths: '750, 1100, 1500, 1900, 2400, 3000, 3840',
        alt: section.settings.image.alt | default: shop.name
    }}
  {%- else -%}
    <img
      class="heipard-hero__image heipard-hero__image--abend"
      src="{{ 'heipard-hero.jpg' | asset_url }}"
      alt="{{ shop.name }}"
      width="2560"
      height="1429"
      loading="eager"
      fetchpriority="high"
    >
  {%- endif -%}
  {%- if hero_mode != 'aus' -%}
    {{
      section.settings.image_day
      | image_url: width: 3840
      | image_tag:
        class: 'heipard-hero__image heipard-hero__image--tag',
        loading: 'eager',
        sizes: '100vw',
        widths: '750, 1100, 1500, 1900, 2400, 2688',
        alt: section.settings.image_day.alt | default: shop.name
    }}
  {%- endif -%}
  {%- if hero_clips and on_json != blank and off_json != blank -%}
    <video
      class="heipard-hero__clip"
      data-clip-on="[{{ on_json | escape }}]"
      data-clip-off="[{{ off_json | escape }}]"
      {% if on_m_json != blank %}data-clip-on-m="[{{ on_m_json | escape }}]"{% endif %}
      {% if off_m_json != blank %}data-clip-off-m="[{{ off_m_json | escape }}]"{% endif %}
      {% if on_s_json != blank %}data-clip-on-schnell="[{{ on_s_json | escape }}]"{% endif %}
      {% if off_s_json != blank %}data-clip-off-schnell="[{{ off_s_json | escape }}]"{% endif %}
      {% if on_sm_json != blank %}data-clip-on-schnell-m="[{{ on_sm_json | escape }}]"{% endif %}
      {% if off_sm_json != blank %}data-clip-off-schnell-m="[{{ off_sm_json | escape }}]"{% endif %}
      muted
      playsinline
      webkit-playsinline
      disablepictureinpicture
      disableremoteplayback
      preload="none"
      aria-hidden="true"
      tabindex="-1"
    ></video>
  {%- endif -%}

  <div class="heipard-hero__overlay" aria-hidden="true"></div>
  {%- if hero_mode != 'aus' -%}
    <div class="heipard-hero__overlay heipard-hero__overlay--tag" aria-hidden="true"></div>
  {%- endif -%}

  <div class="heipard-hero__inner">
    {%- if section.settings.badge_text != blank -%}
      <p class="heipard-hero__badge">{{ section.settings.badge_text | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank or section.settings.accent_word != blank -%}
      <h1 class="heipard-hero__heading">
        {{ section.settings.heading | escape }}
        {%- if section.settings.accent_word != blank %}
          <span class="heipard-hero__accent">{{ section.settings.accent_word | escape }}</span>
        {%- endif -%}
      </h1>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="heipard-hero__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    {%- liquid
      # Buttons nur rendern, wenn Label UND Ziel gesetzt sind (kein href="#").
      assign show_primary_btn = false
      if section.settings.button_primary_label != blank and section.settings.button_primary_link != blank
        assign show_primary_btn = true
      endif
      assign show_secondary_btn = false
      if section.settings.button_secondary_label != blank and section.settings.button_secondary_link != blank
        assign show_secondary_btn = true
      endif
    -%}
    {%- if show_primary_btn or show_secondary_btn -%}
      <div class="heipard-hero__actions">
        {%- if show_primary_btn -%}
          <a
            href="{{ section.settings.button_primary_link }}"
            class="heipard-btn heipard-btn--primary"
          >
            {{ section.settings.button_primary_label | escape }}
          </a>
        {%- endif -%}
        {%- if show_secondary_btn -%}
          <a
            href="{{ section.settings.button_secondary_link }}"
            class="heipard-btn heipard-btn--ghost"
          >
            {{ section.settings.button_secondary_label | escape }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>
{%- if hero_mode != 'aus' -%}
  <script src="{{ 'heipard-hero.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% stylesheet %}
.heipard-hero {
  --hero-ink: oklch(0.98 0.01 80);
  --hero-scrim-bottom: rgba(0, 0, 0, 0.65);
  --hero-scrim-left: rgba(0, 0, 0, 0.4);

  position: relative;
  display: flex;
  align-items: flex-end;
  min-height: var(--heipard-hero-min-height, 600px);
  height: 78vh;
  overflow: hidden;
  isolation: isolate;
}

.heipard-hero__image,
.heipard-hero__fallback {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: -2;
}

.heipard-hero__image {
  object-fit: cover;
}

/* Bild je Modus (Teil H, Vorschau): Tagbild liegt über dem Abendbild und blendet weich. */
.heipard-hero__image--tag {
  opacity: 0;
  transition: opacity 0.8s ease;
}
.heipard-hero[data-bild="tag"] .heipard-hero__image--tag { opacity: 1; }

.heipard-hero__clip {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: -2;
  opacity: 0;
  transition: opacity 0.4s ease;
  pointer-events: none;
}
.heipard-hero__clip.is-on { opacity: 1; transition-duration: 0.15s; }

/* Hinweis am Lichtschalter (Teil I, Abschnitt 7.3, Vorschau): der Schalter leuchtet zweimal auf, darunter
   ein Etikett („Licht an?“ bzw. nach dem Intro am Tag „Licht aus“). Bei reduzierter Bewegung nur das Etikett. */
.heipard-switch.heipard-switch--hinweis { position: relative; }
.heipard-switch--hinweis .heipard-switch__track { animation: heipard-switch-hinweis 1.2s ease-in-out 2; }
@keyframes heipard-switch-hinweis {
  0%, 100% { box-shadow: 0 0 0 0 color-mix(in oklch, var(--glow) 0%, transparent); }
  50% {
    box-shadow:
      0 0 0 0.5rem color-mix(in oklch, var(--glow) 45%, transparent),
      0 0 1.8rem 0.4rem color-mix(in oklch, var(--glow) 55%, transparent);
  }
}
.heipard-switch__hinweis {
  position: absolute;
  top: calc(100% + 0.8rem);
  left: 50%;
  transform: translateX(-50%);
  z-index: 5;
  padding: 0.4rem 1rem;
  border: 1px solid var(--border);
  border-radius: 9999px;
  background: var(--card);
  color: rgb(var(--color-foreground));
  font-size: 1.3rem;
  font-weight: 600;
  line-height: 1.3;
  white-space: nowrap;
  pointer-events: none;
  box-shadow: 0 6px 18px -8px color-mix(in oklch, var(--glow) 45%, transparent);
  opacity: 0;
  transition: opacity 0.4s ease;
}
.heipard-switch__hinweis.is-on { opacity: 1; }
.heipard-switch--ohne-leuchten .heipard-switch__track { animation: none; }
@media (prefers-reduced-motion: reduce) {
  .heipard-switch--hinweis .heipard-switch__track { animation: none; }
  .heipard-switch__hinweis { transition: none; }
}

/* Zusätzlicher Verlauf im Tag-Modus: das helle Tagbild braucht mehr Abdunklung für die weiße Schrift. */
.heipard-hero .heipard-hero__overlay--tag {
  opacity: 0;
  transition: opacity 0.8s ease;
  background:
    linear-gradient(to top, rgba(0, 0, 0, var(--hero-tag-scrim, 0.35)) 0%, transparent 70%),
    linear-gradient(to right, rgba(0, 0, 0, calc(var(--hero-tag-scrim, 0.35) * 0.8)) 0%, transparent 60%);
}
.heipard-hero[data-bild="tag"] .heipard-hero__overlay--tag { opacity: 1; }

@media screen and (max-width: 749px) {
  .heipard-hero--modus .heipard-hero__image,
  .heipard-hero--modus .heipard-hero__clip { object-position: var(--hero-pos-mobile, 50% 50%); }
}

@media (prefers-reduced-motion: reduce) {
  .heipard-hero__image--tag,
  .heipard-hero__overlay--tag { transition: none; }
  .heipard-hero__clip { display: none; }
}

.heipard-hero__fallback {
  background:
    radial-gradient(120% 80% at 80% 110%, color-mix(in oklch, var(--brand) 55%, transparent) 0%, transparent 60%),
    linear-gradient(160deg, var(--secondary) 0%, var(--background) 100%);
}

/* Dawn blendet leere div aus (base.css: div:empty { display: none }); die Verläufe sind leer und
   brauchen deshalb ausdrücklich display: block. Befund Teil H, behoben Teil I (22.11.2026). */
.heipard-hero .heipard-hero__overlay { display: block; }

.heipard-hero__overlay {
  position: absolute;
  inset: 0;
  z-index: -1;
  background:
    linear-gradient(to top, var(--hero-scrim-bottom) 0%, transparent 55%),
    linear-gradient(to right, var(--hero-scrim-left) 0%, transparent 50%);
}

.heipard-hero__inner {
  width: 100%;
  max-width: var(--page-width, 140rem);
  margin-inline: auto;
  padding: 0 5rem 6rem;
  color: var(--hero-ink);
}

.heipard-hero__badge {
  display: inline-block;
  margin: 0 0 2rem;
  padding: 0.7rem 1.4rem;
  border-radius: 9999px;
  border: 1px solid color-mix(in oklch, var(--hero-ink) 30%, transparent);
  background: color-mix(in oklch, var(--hero-ink) 12%, transparent);
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);
  font-size: 1.2rem;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.heipard-hero__heading {
  margin: 0 0 1.8rem;
  max-width: 18ch;
  font-family: var(--font-heipard-display);
  font-weight: 500;
  letter-spacing: -0.02em;
  line-height: 1.02;
  font-size: clamp(3.6rem, 4vw + 2rem, 6.4rem);
  color: var(--hero-ink);
}

.heipard-hero__accent {
  color: var(--heipard-accent-bright);
  text-shadow: 0 0 28px color-mix(in oklch, var(--glow) 60%, transparent);
}

.heipard-hero__subheading {
  margin: 0 0 3rem;
  max-width: 46ch;
  font-size: clamp(1.6rem, 0.6vw + 1.4rem, 2rem);
  line-height: 1.5;
  color: color-mix(in oklch, var(--hero-ink) 88%, transparent);
}

.heipard-hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 1.2rem;
}

.heipard-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 1.2rem 2.4rem;
  border-radius: 9999px;
  font-family: var(--font-heipard-sans);
  font-weight: 600;
  font-size: 1.5rem;
  line-height: 1;
  text-decoration: none;
  cursor: pointer;
  border: 1px solid transparent;
  transition: transform 250ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 250ms ease, background 250ms ease;
}

.heipard-btn--primary {
  background: var(--primary);
  color: var(--primary-foreground);
  box-shadow:
    0 2px 4px color-mix(in oklch, #000 10%, transparent),
    0 16px 48px -12px color-mix(in oklch, var(--glow) 55%, transparent);
}

.heipard-btn--primary:hover {
  transform: translateY(-2px);
  box-shadow:
    0 4px 8px color-mix(in oklch, #000 12%, transparent),
    0 20px 56px -10px color-mix(in oklch, var(--glow) 70%, transparent);
}

.heipard-btn--ghost {
  background: color-mix(in oklch, var(--hero-ink) 10%, transparent);
  color: var(--hero-ink);
  border-color: color-mix(in oklch, var(--hero-ink) 45%, transparent);
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);
}

.heipard-btn--ghost:hover {
  transform: translateY(-2px);
  background: color-mix(in oklch, var(--hero-ink) 18%, transparent);
}

@media screen and (max-width: 749px) {
  .heipard-hero {
    height: auto;
    min-height: var(--heipard-hero-min-height, 600px);
  }
  .heipard-hero__inner {
    padding: 0 2rem 4rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .heipard-btn { transition: none; }
  .heipard-btn:hover { transform: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "HeiPard Hero",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hintergrundbild (Abendszene, warmes Licht)"
    },
    {
      "type": "header",
      "content": "Lichtschalter schaltet das Bild"
    },
    {
      "type": "select",
      "id": "switch_mode",
      "label": "Bild je Modus",
      "options": [
        { "value": "aus", "label": "Aus: immer das Abendbild" },
        { "value": "bilder", "label": "Tagbild und Abendbild, weicher Wechsel" },
        { "value": "clip", "label": "Wie oben, beim Umschalten läuft der Clip" },
        { "value": "clip_intro", "label": "Wie oben, dazu Clip beim ersten Aufruf am Abend" }
      ],
      "default": "aus"
    },
    {
      "type": "image_picker",
      "id": "image_day",
      "label": "Tagbild (Lichterketten aus)",
      "info": "Ohne Tagbild bleibt es beim Abendbild."
    },
    {
      "type": "video",
      "id": "clip_on",
      "label": "Clip Licht an (Tag zu Abend)"
    },
    {
      "type": "video",
      "id": "clip_off",
      "label": "Clip Licht aus (Abend zu Tag)"
    },
    {
      "type": "video",
      "id": "clip_on_m",
      "label": "Clip Licht an, Mobil-Fassung",
      "info": "Unter 750 px Breite läuft ein Clip nur mit Mobil-Fassung."
    },
    {
      "type": "video",
      "id": "clip_off_m",
      "label": "Clip Licht aus, Mobil-Fassung"
    },
    {
      "type": "select",
      "id": "tempo",
      "label": "Tempo der Clips",
      "options": [
        { "value": "normal", "label": "Normal (etwa 8 s)" },
        { "value": "schnell", "label": "Schnell (etwa 4 s)" }
      ],
      "default": "normal"
    },
    {
      "type": "video",
      "id": "clip_on_schnell",
      "label": "Clip Licht an, schnell"
    },
    {
      "type": "video",
      "id": "clip_off_schnell",
      "label": "Clip Licht aus, schnell"
    },
    {
      "type": "video",
      "id": "clip_on_schnell_m",
      "label": "Clip Licht an, schnell, Mobil-Fassung"
    },
    {
      "type": "video",
      "id": "clip_off_schnell_m",
      "label": "Clip Licht aus, schnell, Mobil-Fassung"
    },
    {
      "type": "select",
      "id": "tag_modus",
      "label": "Tag-Modus",
      "info": "Hinweis: im Tag-Modus leuchtet der Schalter einmal je Sitzung mit „Licht an?“. Intro (nur mit „Clip beim ersten Aufruf am Abend“): auch am Tag läuft „Licht an“ einmal, danach wechselt die Seite in die Abendstimmung, ohne die Wahl zu speichern.",
      "options": [
        { "value": "aus", "label": "Aus" },
        { "value": "hinweis", "label": "Hinweis am Schalter" },
        { "value": "intro", "label": "Intro auch am Tag" }
      ],
      "default": "aus"
    },
    {
      "type": "range",
      "id": "day_scrim",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Zusätzlicher Verlauf im Tag-Modus",
      "default": 35
    },
    {
      "type": "range",
      "id": "mobile_position",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Bildausschnitt mobil (waagerecht)",
      "info": "0 % links, 50 % Mitte, 100 % rechts. Gilt für Bilder und Clip.",
      "default": 50
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Saison-Badge",
      "default": "Saison 2026 — frisch eingetroffen"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Lasse deine Welt"
    },
    {
      "type": "text",
      "id": "accent_word",
      "label": "Akzentwort (hervorgehoben)",
      "default": "erleuchten."
    },
    {
      "type": "textarea",
