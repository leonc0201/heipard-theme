{% comment %}
  HeiPard Footer — Markenspalte + Beschreibung · Kategorien · Kontakt ·
  Bottom-Bar (Copyright + Rechtliches + Land/Waehrung).
  Newsletter-Anmeldung wurde entfernt (kein Double-Opt-in vorhanden).
  Kontaktdaten sind echte Werte, keine Platzhalter mehr.
  Styles: assets/heipard-footer.css (global, laedt nach base.css -> Abstaende
  werden nicht von Dawn-Klassen genullt).
{% endcomment %}

<footer class="heipard-footer color-{{ section.settings.color_scheme }}">
  <div class="page-width heipard-footer__top">

    <div class="heipard-footer__brand">
      <a href="{{ routes.root_url }}" class="heipard-footer__logo">{% render 'heipard-wordmark' %}</a>
      {%- if section.settings.brand_description != blank -%}
        <p class="heipard-footer__desc">{{ section.settings.brand_description | escape }}</p>
      {%- endif -%}

      {%- liquid
        # Seiten-URL bevorzugen (ist bereits sprach-/marktpraefigiert),
        # sonst Pfad aus routes.root_url bauen (Fallback, falls Seite fehlt).
        assign withdrawal_page = pages['vertrag-widerrufen']
        if withdrawal_page.url != blank
          assign withdrawal_url = withdrawal_page.url
        else
          assign withdrawal_root = routes.root_url | remove_last: '/'
          assign withdrawal_url = withdrawal_root | append: '/pages/vertrag-widerrufen'
        endif
      -%}
      <a href="{{ withdrawal_url }}" class="heipard-footer__withdraw">
        {{- 'heipard.footer.withdraw_contract' | t -}}
      </a>
    </div>

    <div class="heipard-footer__col">
      <h4 class="heipard-footer__heading">{{ section.settings.categories_heading | escape }}</h4>
      {%- if section.settings.categories_menu != blank -%}
        <ul class="heipard-footer__links">
          {%- for link in section.settings.categories_menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="heipard-footer__col">
      <h4 class="heipard-footer__heading">{{ section.settings.service_heading | escape }}</h4>
      <ul class="heipard-footer__links heipard-footer__contact">
        {%- if section.settings.service_email_business != blank -%}
          <li class="heipard-footer__contact-row">
            <span class="heipard-footer__contact-icon" aria-hidden="true">
              {{- 'icon-mail.svg' | inline_asset_content -}}
            </span>
            <span>
              {{ 'heipard.footer.email_business' | t }}:
              <a href="mailto:{{ section.settings.service_email_business }}">{{ section.settings.service_email_business | escape }}</a>
            </span>
          </li>
        {%- endif -%}
        {%- if section.settings.service_email_support != blank -%}
          <li class="heipard-footer__contact-row">
            <span class="heipard-footer__contact-icon" aria-hidden="true">
              {{- 'icon-mail.svg' | inline_asset_content -}}
            </span>
            <span>
              {{ 'heipard.footer.email_support' | t }}:
              <a href="mailto:{{ section.settings.service_email_support }}">{{ section.settings.service_email_support | escape }}</a>
            </span>
          </li>
        {%- endif -%}
        {%- if section.settings.service_phone != blank -%}
          {%- liquid
            assign phone_href = section.settings.service_phone_link
            if phone_href == blank
              assign phone_href = section.settings.service_phone | remove: ' ' | remove: '/' | remove: '-'
            endif
          -%}
          <li class="heipard-footer__contact-row">
            <span class="heipard-footer__contact-icon" aria-hidden="true">
              {{- 'icon-phone.svg' | inline_asset_content -}}
            </span>
            <span><a href="tel:{{ phone_href }}">{{ section.settings.service_phone | escape }}</a></span>
          </li>
        {%- endif -%}
        {%- if section.settings.service_hours != blank -%}
          <li class="heipard-footer__contact-row">
            <span class="heipard-footer__contact-icon" aria-hidden="true">
              {{- 'icon-clock.svg' | inline_asset_content -}}
            </span>
            <span>{{ section.settings.service_hours | escape }}</span>
          </li>
        {%- endif -%}
        {%- if section.settings.help_link != blank -%}
          <li class="heipard-footer__contact-row heipard-footer__contact-row--plain">
            <a href="{{ section.settings.help_link }}">{{ 'heipard.footer.help_faq' | t }}</a>
          </li>
        {%- endif -%}
        {%- if section.settings.dealer_link != blank -%}
          <li class="heipard-footer__contact-row heipard-footer__contact-row--plain">
            <a href="{{ section.settings.dealer_link }}">{{ 'heipard.footer.become_dealer' | t }}</a>
          </li>
        {%- endif -%}
      </ul>
    </div>

  </div>

  <div class="heipard-footer__bottom">
    <div class="page-width heipard-footer__bottom-inner">
      <p class="heipard-footer__copyright">&copy; {{ 'now' | date: '%Y' }} HeiPard &mdash; eine Marke der C&amp;L Handels GmbH</p>

      {%- liquid
        # shop.policies enthaelt das Impressum (LEGAL_NOTICE) nicht zuverlaessig.
        # Deshalb pruefen, ob es doch dabei ist - sonst separaten Link aus der
        # Section-Einstellung anhaengen (Pflichtangabe nach § 5 DDG).
        assign legal_notice_found = false
        for policy in shop.policies
          assign policy_title = policy.title | downcase
          if policy_title contains 'impressum' or policy_title contains 'legal notice' or policy_title contains 'mentions' or policy_title contains 'aviso legal' or policy_title contains 'note legali'
            assign legal_notice_found = true
          endif
        endfor
      -%}
      <ul class="heipard-footer__legal">
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}
            <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
          {%- endif -%}
        {%- endfor -%}
        {%- if legal_notice_found == false and section.settings.legal_notice_link != blank -%}
          <li><a href="{{ section.settings.legal_notice_link }}">{{ 'heipard.footer.legal_notice' | t }}</a></li>
        {%- endif -%}
      </ul>

      {%- if localization.available_countries.size > 1 -%}
        <div class="heipard-footer__locale">
          {%- form 'localization' -%}
            <label class="visually-hidden" for="FooterCountrySelect">{{ 'heipard.footer.country_region' | t }}</label>
            <select id="FooterCountrySelect" name="country_code" class="heipard-footer__locale-select" onchange="this.form.submit()">
              {%- for country in localization.available_countries -%}
                <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                  {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                </option>
              {%- endfor -%}
            </select>
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "HeiPard Footer",
  "settings": [
    { "type": "textarea", "id": "brand_description", "label": "Marken-Beschreibung", "default": "Stimmungsvolle Beleuchtung vom Niederrhein. Für drinnen, draußen und unterwegs." },
    { "type": "text", "id": "categories_heading", "label": "Spalte 2 – Überschrift", "default": "Kategorien" },
    { "type": "link_list", "id": "categories_menu", "label": "Spalte 2 – Menü", "default": "main-menu" },
    { "type": "text", "id": "service_heading", "label": "Spalte 3 – Überschrift", "default": "Service" },
    { "type": "text", "id": "service_email_business", "label": "Kontakt – E-Mail Business", "default": "info@heipard.com" },
    { "type": "text", "id": "service_email_support", "label": "Kontakt – E-Mail Support", "default": "service@heipard.com" },
    { "type": "text", "id": "service_phone", "label": "Kontakt – Telefon", "default": "02154 953 65 30" },
    { "type": "text", "id": "service_phone_link", "label": "Kontakt – Telefon (Wählnummer)", "info": "Für den tel:-Link, international mit Ländervorwahl. Leer = Anzeigenummer ohne Leerzeichen.", "default": "+4921549536530" },
    { "type": "text", "id": "service_hours", "label": "Kontakt – Zeiten", "default": "Mo - Fr | 09:00 - 16:00 Uhr" },
    { "type": "url", "id": "help_link", "label": "Service – Hilfe & FAQ Link", "info": "Leer = Eintrag wird ausgeblendet (statt Link ins Leere)." },
    { "type": "url", "id": "dealer_link", "label": "Service – Händler-werden Link", "info": "Leer = Eintrag wird ausgeblendet (statt Link ins Leere)." },
    { "type": "url", "id": "legal_notice_link", "label": "Impressum-Link (Bottom-Bar)", "info": "Pflichtangabe. Shopify liefert das Impressum nicht über shop.policies aus – hier die Richtlinie bzw. Seite auswählen." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-1" }
  ],
  "presets": [{ "name": "HeiPard Footer" }]
}
{% endschema %}
