{% comment %}
  HeiPard Saison-Block — wechselnder Aufmacher direkt unter dem Hero.
  Vollstaendig im Customizer konfigurierbar (Kicker, Ueberschrift, Text, Bild,
  Button, Link), ein-/ausschaltbar, optional eine Produktreihe aus einer
  waehlbaren Kollektion (HeiPard-Karten, Skeleton wenn leer).
  Platzhalter bewusst als [TBD] -> keine erfundenen Inhalte.
  Styles: assets/heipard-sections.css (global, nach base.css -> keine genullten
  Abstaende). Funktioniert in Tag & Abendstimmung.
{% endcomment %}

{%- if section.settings.section_enabled -%}
  <section class="heipard-section heipard-season color-{{ section.settings.color_scheme }}">
    <div class="page-width">
      <div class="heipard-season__banner">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag:
              class: 'heipard-season__img',
              loading: 'lazy',
              widths: '600, 900, 1300, 1800, 2400',
              sizes: '(min-width: 750px) 90vw, 100vw',
              alt: section.settings.heading | default: section.settings.image.alt
          }}
        {%- else -%}
          <span class="heipard-season__img heipard-season__fallback" aria-hidden="true"></span>
        {%- endif -%}
        <span class="heipard-season__scrim" aria-hidden="true"></span>

        <div class="heipard-season__content">
          {%- if section.settings.kicker != blank -%}
            <span class="heipard-season__kicker">{{ section.settings.kicker | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="heipard-season__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.description != blank -%}
            <p class="heipard-season__desc">{{ section.settings.description | escape }}</p>
          {%- endif -%}
          {%- if section.settings.button_label != blank -%}
            <a class="heipard-season__btn" href="{{ section.settings.button_link | default: '#' }}">
              {{ section.settings.button_label | escape }}
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- if section.settings.show_products -%}
        <div class="heipard-season__products">
          {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
            {%- for product in section.settings.collection.products limit: section.settings.products_count -%}
              {% render 'heipard-product-card', product: product %}
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..section.settings.products_count) -%}
              <div class="heipard-card heipard-card--skeleton" aria-hidden="true">
                <div class="heipard-card__media">
                  <span class="heipard-card__img heipard-card__fallback"></span>
                </div>
                <div class="heipard-card__row">
                  <span class="heipard-skel heipard-skel--name"></span>
                  <span class="heipard-skel heipard-skel--price"></span>
                </div>
                <span class="heipard-skel heipard-skel--sub"></span>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "HeiPard Saison-Block",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "section_enabled", "label": "Saison-Block anzeigen", "info": "Zwischen den Saisons abschaltbar.", "default": true },
    { "type": "header", "content": "Aufmacher" },
    { "type": "image_picker", "id": "image", "label": "Hintergrund-/Stimmungsbild" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Saison" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "[TBD: Saison-Überschrift]" },
    { "type": "textarea", "id": "description", "label": "Beschreibungstext", "default": "[TBD: kurzer Saison-Text]" },
    { "type": "text", "id": "button_label", "label": "Button-Text (leer = kein Button)" },
    { "type": "url", "id": "button_link", "label": "Button-Link" },
    { "type": "header", "content": "Optionale Produktreihe" },
    { "type": "checkbox", "id": "show_products", "label": "Produktreihe anzeigen", "default": false },
    { "type": "collection", "id": "collection", "label": "Kollektion (z. B. Solar)" },
    { "type": "range", "id": "products_count", "min": 2, "max": 8, "step": 1, "label": "Anzahl Produkte", "default": 4 },
    { "type": "header", "content": "Darstellung" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-1" }
  ],
  "presets": [{ "name": "HeiPard Saison-Block" }]
}
{% endschema %}
